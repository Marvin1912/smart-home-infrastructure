[Unit]
Description=Touch dashboard kiosk
After=default.target

[Service]
Type=simple
Environment=WAYLAND_DISPLAY=wayland-0
# Wipe the Chromium profile before every start so a redeploy of the frontend
# is guaranteed to be picked up. A restarted process alone is not enough: the
# profile persists across restarts, and any Service Worker / Cache Storage
# registered by the app intercepts fetches before HTTP cache headers (e.g.
# the Traefik no-cache middleware) ever come into play, so a stale app can
# keep being served indefinitely otherwise.
ExecStartPre=/bin/rm -rf %h/.config/chromium
ExecStart=/usr/bin/chromium --kiosk --noerrdialogs --disable-translate \
  --disable-features=TranslateUI --check-for-update-interval=31536000 \
  --disable-pinch --overscroll-history-navigation=0 \
  --password-store=basic --no-first-run --no-default-browser-check \
  --app=http://frontend.home-lab.com/touch
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
