[Unit]
Description=Touch dashboard kiosk
After=default.target

[Service]
Type=simple
Environment=WAYLAND_DISPLAY=wayland-0
# --incognito keeps Chromium from persisting a profile across restarts, so a
# redeployed frontend is always picked up fresh: no Service Worker / Cache
# Storage from a stale app can survive to intercept fetches before HTTP
# cache headers (e.g. the Traefik no-cache middleware) come into play.
ExecStart=/usr/bin/chromium --kiosk --incognito --noerrdialogs --disable-translate \
  --disable-features=TranslateUI --check-for-update-interval=31536000 \
  --disable-pinch --overscroll-history-navigation=0 \
  --password-store=basic --no-first-run --no-default-browser-check \
  --app=https://frontend.geitner.cc/touch
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
